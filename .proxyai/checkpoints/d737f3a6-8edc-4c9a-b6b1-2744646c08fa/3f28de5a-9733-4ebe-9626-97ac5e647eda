       std = close.rolling(window=CONFIG.bbands_period).std()\n125\t        upper = mid + CONFIG.bbands_nbdev * std\n126\t        lower = mid - CONFIG.bbands_nbdev * std\n127\t        return upper, mid, lower\n128\t\n129\t\n130\tdef calc_vegas_emas(close: pd.Series) -> Dict[int, pd.Series]:\n131\t    \"\"\"计算维加斯通道EMA\"\"\"\n132\t    result = {}\n133\t    for period in CONFIG.vegas_periods:\n134\t        result[period] = close.ewm(span=period, adjust=False).mean()\n135\t    return result\n136\t\n137\t\n138\t# ============================================================\n139\t# 日期工具函数\n140\t# ============================================================\n141\tdef to_date_str(date) -> str:\n142\t    \"\"\"统一转换为 YYYYMMDD 格式\"\"\"\n143\t    if isinstance(date, datetime.date):\n144\t        return date.strftime(\"%Y%m%d\")\n145\t    if isinstance(date, pd.Timestamp):\n146\t        return date.strftime(\"%Y%m%d\")\n147\t    return str(date).replace(\"-\", \"\")\n148\t\n149\t\n150\tdef to_dash_date(date) -> str:\n151\t    \"\"\"统一转换为 YYYY-MM-DD 格式\"\"\"\n152\t    if isinstance(date, (datetime.date, pd.Timestamp)):\n153\t        return date.strftime(\"%Y-%m-%d\")\n154\t    s = str(date).replace(\"-\", \"\")\n155\t    return f\"{s[:4]}-{s[4:6]}-{s[6:8]}\"\n156\t\n157\t\n158\tdef get_trade_dates(end_date: str, count: int) -> List[str]:\n159\t    \"\"\"获取最近N个交易日日期列表\"\"\"\n160\t    try:\n161\t        df = ak.tool_trade_date_hist_sina()\n162\t        dates = pd.to_datetime(df[\"trade_date\"]).sort_values()\n163\t        end_dt = pd.to_datetime(end_date)\n164\t        mask = dates <= end_dt\n165\t        return dates[mask].tail(count).dt.strftime(\"%Y%m%d\").tolist()\n166\t    except Exception:\n167\t        end_dt = pd.to_datetime(end_date)\n168\t        return [(end_dt - pd.Timedelta(days=i)).strftime(\"%Y%m%d\") for i in range(count * 2)][::-1]\n169\t\n170\t\n171\tdef get_latest_trade_date(date_str: str) -> str:\n172\t    \"\"\"返回 <= date_str 的最近一个交易日，格式 YYYY-MM-DD\"\"\"\n173\t    try:\n174\t        df = ak.tool_trade_date_hist_sina()\n175\t        dates = pd.to_datetime(df[\"trade_date\"]).sort_values()\n176\t        target = pd.to_datetime(date_str)\n177\t        valid = dates[dates <= target]\n178\t        if len(valid) > 0:\n179\t            return valid.iloc[-1].strftime(\"%Y-%m-%d\")\n180\t    except Exception:\n181\t        pass\n182\t    return date_str\n183\t\n184\t\n185\t# ============================================================\n186\t# 数据获取函数（带重试机制 + 指数退避）\n187\t# ============================================================\n188\tdef _safe_ak_call(func, *args, description=\"\", **kwargs):\n189\t    \"\"\"\n190\t    带指数退避重试的 akshare 请求包装器。\n191\t    处理 ConnectionError、超时等网络异常。\n192\t    \"\"\"\n193\t    last_error = None\n194\t    for attempt in range(1, CONFIG.max_retries + 1):\n195\t        try:\n196\t            time.sleep(CONFIG.request_delay + random.uniform(0, 0.2))\n197\t            result = func(*args, **kwargs)\n198\t            return result\n199\t        except (\n200\t            requests.exceptions.ConnectionError,\n201\t            requests.exceptions.Timeout,\n202\t            requests.exceptions.HTTPError,\n203\t            ConnectionError,\n204\t            TimeoutError,\n205\t            OSError,\n206\t        ) as e:\n207\t            last_error = e\n208\t            if attempt < CONFIG.max_retries:\n209\t                wait = CONFIG.request_delay * (2 ** attempt)\n210\t                desc = f\" ({description})\" if description else \"\"\n211\t                print(f\"    ⚠ 网络异常{desc}，{wait:.1f}s 后重试 ({attempt}/{CONFIG.max_retries})\")\n212\t                time.sleep(wait)\n213\t        except Exception as e:\n214\t            last_error = e\n215\t            break\n216\t\n217\t    if last_error:\n218\t        desc = f\" ({description})\" if description else \"\"\n219\t        print(f\"    ❌ 请求失败{desc}: {last_error}\")\n220\t    return None\n221\t\n222\t\n223\tdef fetch_stock_pool() -> pd.DataFrame:\n224\t    \"\"\"获取选股池：全A股 - ST - 上市不满60日\"\"\"\n225\t    print(\"  获取全A股列表...\")\n226\t    df = _safe_ak_call(ak.stock_zh_a_spot_em, description=\"全A股列表\")\n227\t    if df is None:\n228\t        return pd.DataFrame()\n229\t    df = df[~df[\"名称\"].str.contains(\"ST\", na=False)]\n230\t    df = df[~df[\"名称\"].str.contains(\"退\", na=False)]\n231\t    df = df[df[\"代码\"].str.match(r\"^\\d{6}$\")]\n232\t    print(f\"  选股池股票数量: {len(df)}\")\n233\t    return df\n234\t\n235\t\n236\tdef fetch_board_list() -> pd.DataFrame:\n237\t    \"\"\"获取同花顺概念板块列表\"\"\"\n238\t    print(\"  获取概念板块列表...\")\n239\t    df = _safe_ak_call(ak.stock_board_concept_name_ths, description=\"概念板块列表\")\n240\t    if df is None:\n241\t        return pd.DataFrame()\n242\t    # 统一列名：兼容中英文两种列名格式\n243\t    rename_map = {}\n244\t    for col in df.columns:\n245\t        col_lower = str(col).lower()\n246\t        if col_lower == \"code\" and \"概念代码\" not in df.columns and \"代码\" not in df.columns:\n247\t            rename_map[col] = \"概念代码\"\n248\t        elif col_lower == \"name\" and \"概念名称\" not in df.columns:\n249\t            rename_map[col] = \"概念名称\"\n250\t    if rename_map:\n251\t        df = df.rename(columns=rename_map)\n252\t    print(f\"  概念板块数量: {len(df)}, 列名: {list(df.columns)}\")\n253\t    return df\n254\t\n255\t\n256\tdef fetch_board_index(board_code: str, start_date: str, end_date: str) -> pd.DataFrame:\n257\t    \"\"\"获取板块指数K线（同花顺）\"\"\"\n258\t    result = _safe_ak_call(\n259\t        ak.stock_board_concept_index_ths,\n260\t        symbol=board_code,\n261\t        start_date=start_date,\n262\t        end_date=end_date,\n263\t        description=f\"板块指数 {board_code}\",\n264\t    )\n265\t    if result is None:\n266\t        return pd.DataFrame()\n267\t    if isinstance(result, pd.DataFrame) and len(result) > 0:\n268\t        result[\"日期\"] = pd.to_datetime(result[\"日期\"])\n269\t        result = result.sort_values(\"日期\").reset_index(drop=True)\n270\t    return result\n271\t\n272\t\n273\tdef _parse_html_tables(text: str) -> List[pd.DataFrame]:\n274\t    \"\"\"安全解析 HTML 表格，抑制 lxml/html5lib 的解析输出\"\"\"\n275\t    # 预检查：确认 HTML 中包含 <table 标签\n276\t    if \"<table\" not in text.lower():\n277\t        return []\n278\t\n279\t    old_stdout = sys.stdout\n280\t    old_stderr = sys.stderr\n281\t    sys.stdout = io.StringIO()\n282\t    sys.stderr = io.StringIO()\n283\t    try:\n284\t        return pd.read_html(io.StringIO(text))\n285\t    except ValueError:\n286\t        return []\n287\t    finally:\n288\t        sys.stdout = old_stdout\n289\t        sys.stderr = old_stderr\n290\t\n291\t\n292\tdef fetch_board_constituents(board_code: str, board_name: str = \"\") -> pd.DataFrame:\n293\t    \"\"\"获取板块成分股（解析板块主页HTML表格，不走AJAX接口）\"\"\"\n294\t    headers = {\n295\t        \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36\",\n296\t        \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n297\t        \"Accept-Language\": \"zh-CN,zh;q=0.9\",\n298\t    }\n299\t\n300\t    all_records = []\n301\t    session = requests.Session()\n302\t    session.headers.update(headers)\n303\t\n304\t    main_url = f\"http://q.10jqka.com.cn/gn/detail/code/{board_code}/\"\n305\t\n306\t    for attempt in range(1, CONFIG.max_retries + 1):\n307\t        try:\n308\t            time.sleep(CONFIG.request_delay + random.uniform(0, 0.2))\n309\t            resp = session.get(main_url, timeout=15)\n310\t            resp.raise_for_status()\n311\t\n312\t            # 主页用 utf-8，AJAX 分页用 gbk\n313\t            try:\n314\t                text = resp.content.decode(\"gbk\")\n315\t            except Exception:\n316\t                text = resp.text\n317\t\n318\t            # 从主页 HTML 中找成分股表格（使用安全解析函数）\n319\t            dfs = _parse_html_tables(text)\n320\t            if not dfs:\n321\t                return pd.DataFrame()\n322\t\n323\t            # 找到成分股表格（通常第一个含代码列的表格）\n324\t            found = False\n325\t            for df in dfs:\n326\t                if df.empty or df.shape[1] < 3:\n327\t                    continue\n328\t                # 检查第2列是否像股票代码（6位数字）\n329\t                sample = str(df.iloc[:, 1].dropna().iloc[0]) if len(df) > 0 else \"\"\n330\t                if not (sample.replace(\" \", \"\").isdigit() and 5 <= len(sample.replace(\" \", \"\")) <= 6):\n331\t                    continue\n332\t\n333\t                for _, row in df.iterrows():\n334\t                    code = str(row.iloc[1]).replace(\" \", \"\").zfill(6)\n335\t                    name = str(row.iloc[2]).replace(\" \", \"\")\n336\t                    if code.isdigit() and len(code) == 6:\n337\t                        all_records.append({\"代码\": code, \"名称\": name})\n338\t                found = True\n339\t                break\n340\t\n341\t            if not found:\n342\t                return pd.DataFrame()\n343\t\n344\t            # 如果主页只有第一页（通常50条），尝试翻页加载更多\n345\t            if len(all_records) >= 40:\n346\t                for page in range(2, 30):\n347\t                    ajax_url = f\"http://q.10jqka.com.cn/gn/detail/order/desc/page/{page}/ajax/1/code/{board_code}/\"\n348\t                    ajax_headers = {\n349\t                        \"Referer\": main_url,\n350\t                        \"X-Requested-With\": \"XMLHttpRequest\",\n351\t                        \"Accept\": \"text/html, */*; q=0.01\",\n352\t                    }\n353\t                    try:\n354\t                        time.sleep(CONFIG.request_delay + random.uniform(0, 0.2))\n355\t                        resp2 = session.get(ajax_url, headers=ajax_headers, timeout=15)\n356\t                        resp2.raise_for_status()\n357\t                        try:\n358\t                            page_text = resp2.content.decode(\"gbk\")\n359\t                        except Exception:\n360\t                            page_text = resp2.text\n361\t                        if not page_text.strip() or \"暂无数据\" in page_text:\n362\t                            break\n363\t                        dfs2 = _parse_html_tables(page_text)\n364\t                        if not dfs2 or dfs2[0].empty:\n365\t                            break\n366\t                        df2 = dfs2[0]\n367\t                        page_added = 0\n368\t                        for _, row in df2.iterrows():\n369\t                            code = str(row.iloc[1]).replace(\" \", \"\").zfill(6)\n370\t                            name = str(row.iloc[2]).replace(\" \", \"\")\n371\t                            if code.isdigit() and len(code) == 6:\n372\t                                all_records.append({\"代码\": code, \"名称\": name})\n373\t                                page_added += 1\n374\t                        if page_added == 0 or len(df2) < 40:\n375\t                            break\n376\t                    except Exception:\n377\t                        break\n378\t\n379\t            break\n380\t        except Exception as e:\n381\t            if attempt < CONFIG.max_retries:\n382\t                wait = CONFIG.request_delay * (2 ** attempt)\n383\t                time.sleep(wait)\n384\t            else:\n385\t                print(f\"    ❌ 请求失败 (板块成分股 {board_code}): {e}\")\n386\t                return pd.DataFrame()\n387\t\n388\t    if not all_records:\n389\t        return pd.DataFrame()\n390\t\n391\t    result = pd.DataFrame(all_records)\n392\t    result[\"板块代码\"] = board_code\n393\t    return result\n394\t\n395\t\n396\tdef fetch_limit_up_pool(trade_date: str) -> pd.DataFrame:\n397\t    \"\"\"获取某日涨停板数据\"\"\"\n398\t    result = _safe_ak_call(\n399\t        ak.stock_zt_pool_em,\n400\t        date=trade_date,\n401\t        description=f\"涨停板 {trade_date}\",\n402\t    )\n403\t    if result is None:\n404\t        return pd.DataFrame()\n405\t    if isinstance(result, pd.DataFrame) and len(result) > 0:\n406\t        result[\"日期\"] = trade_date\n407\t    return result\n408\t\n409\t\n410\tdef fetch_stock_daily(code: str, start_date: str, end_date: str) -> pd.DataFrame:\n411\t    \"\"\"获取个股日K线（前复权）\"\"\"\n412\t    result = _safe_ak_call(\n413\t        ak.stock_zh_a_hist,\n414\t        symbol=code,\n415\t        period=\"daily\",\n416\t        start_date=start_date,\n417\t        end_date=end_date,\n418\t        adjust=\"qfq\",\n419\t        description=f\"个股日线 {code}\",\n420\t    )\n421\t    if result is None:\n422\t        return pd.DataFrame()\n423\t    if isinstance(result, pd.DataFrame) and len(result) > 0:\n424\t        result[\"日期\"] = pd.to_datetime(result[\"日期\"])\n425\t        result = result.sort_values(\"日期\").reset_index(drop=True)\n426\t    return result\n427\t\n428\t\n429\t# ============================================================\n430\t# 股票→概念反向索引（本地缓存，30天刷新一次）\n431\t# ============================================================\n432\tSTOCK_CONCEPT_CACHE = os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"data\", \"stock_concept_index.json\")\n433\t\n434\t\n435\tdef build_stock_concept_index(force_refresh: bool = False) -> Dict:\n436\t    \"\"\"\n437\t    构建 stock_code → [{概念名称, 概念代码}, ...] 反向索引。\n438\t    首次/超30天自动全量下载板块成分股（约3-5分钟），之后秒查。\n439\t    \"\"\"\n440\t    # ---- 检查缓存：30天内有效且非空 ----\n441\t    if not force_refresh and os.path.exists(STOCK_CONCEPT_CACHE):\n442\t        mtime = datetime.date.fromtimestamp(os.path.getmtime(STOCK_CONCEPT_CACHE))\n443\t        if (datetime.date.today() - mtime).days < 30:\n444\t            print(f\"  ✓ 加载本地缓存 ({mtime}): data/stock_concept_index.json\")\n445\t            with open(STOCK_CONCEPT_CACHE, \"r\", encoding=\"utf-8\") as f:\n446\t                cached = json.load(f)\n447\t            if cached:\n448\t                return cached\n449\t            print(\"  ⚠ 缓存为空，重新构建...\")\n450\t\n451\t    print(\"  ⏳ 构建股票→概念反向索引（首次需下载全部板块成分股，约3-5分钟，30天仅一次）...\")\n452\t\n453\t    boards = fetch_board_list()\n454\t    if boards.empty:\n455\t        return {}\n456\t\n457\t    stock_concept_map = {}\n458\t    total = len(boards)\n459\t\n460\t    for idx, (_, row) in enumerate(boards.iterrows()):\n461\t        board_name = row[\"概念名称\"]\n462\t        raw_code = str(row.get(\"概念代码\", row.get(\"code\", \"\")))\n463\t        if \"/\" in raw_code:\n464\t            board_num_code = raw_code.rstrip(\"/\").split(\"/\")[-1]\n465\t        else:\n466\t            board_num_code = raw_code\n467\t\n468\t        if (idx + 1) % 50 == 0 or idx == 0:\n469\t            print(f\"    进度: {idx+1}/{total}\")\n470\t\n471\t        constituents = fetch_board_constituents(board_num_code, board_name)\n472\t        if constituents.empty:\n473\t            continue\n474\t\n475\t        for _, stock_row in constituents.iterrows():\n476\t            code = stock_row[\"代码\"]\n477\t            if code not in stock_concept_map:\n478\t                stock_concept_map[code] = []\n479\t            stock_concept_map[code].append({\n480\t                \"概念名称\": board_name,\n481\t                \"概念代码\": board_num_code,\n482\t            })\n483\t\n484\t    # ---- 写入缓存 ----\n485\t    cache_dir = os.path.dirname(STOCK_CONCEPT_CACHE)\n486\t    os.makedirs(cache_dir, exist_ok=True)\n487\t    with open(STOCK_CONCEPT_CACHE, \"w\", encoding=\"utf-8\") as f:\n488\t        json.dump(stock_concept_map, f, ensure_ascii=False, indent=2)\n489\t    print(f\"  ✓ 索引已缓存至: {STOCK_CONCEPT_CACHE}，覆盖 {len(stock_concept_map)} 只股票\")\n490\t\n491\t    return stock_concept_map\n492\t\n493\t\n494\t# ============================================================\n495\t# 第一步：筛选主线板块\n496\t# ============================================================\n497\tdef screen_main_sectors(eval_date: str) -> List[Dict]:\n498\t    \"\"\"\n499\t    新逻辑：龙头先行，反查板块\n500\t    第1步：找出潜在龙头（近5日涨停>=4天）\n501\t    第2步：检索龙头所属的全部概念板块\n502\t    第3步：计算板块近3日涨幅和日均涨停家数\n503\t    第4步：涨幅排名前5%\n504\t    第5步：筛选同时满足条件的板块（涨幅>=阈值 且 日均涨停>=3）\n505\t    \"\"\"\n506\t    print(\"\\n===== 第一步：筛选主线板块 =====\")\n507\t\n508\t    date_str = to_date_str(eval_date)\n509\t    trade_dates = get_trade_dates(eval_date, 10)\n510\t    recent_5_dates = trade_dates[-5:]\n511\t    recent_3_dates = trade_dates[-3:]\n512\t\n513\t    print(f\"  评估日期: {eval_date}\")\n514\t    print(f\"  近5个交易日: {recent_5_dates}\")\n515\t\n516\t    # ----------------------------------------------------------------\n517\t    # 第1步：找出潜在龙头（近5日涨停>=4天）\n518\t    # ----------------------------------------------------------------\n519\t    print(\"\\n  [第1步] 找出潜在龙头（近5日涨停>=4天）...\")\n520\t\n521\t    all_limit_up_data = {}\n522\t    for d in recent_5_dates:\n523\t        all_limit_up_data[d] = fetch_limit_up_pool(d)\n524\t\n525\t    stock_zt_count = {}\n526\t    stock_zt_detail = {}\n527\t\n528\t    for d in recent_5_dates:\n529\t        lt_data = all_limit_up_data.get(d)\n530\t        if lt_data is None or lt_data.empty:\n531\t            continue\n532\t        for _, row in lt_data.iterrows():\n533\t            code = row[\"代码\"]\n534\t            stock_zt_count[code] = stock_zt_count.get(code, 0) + 1\n535\t            if code not in stock_zt_detail:\n536\t                stock_zt_detail[code] = {\n537\t                    \"代码\": code,\n538\t                    \"名称\": row.get(\"名称\", \"\"),\n539\t                    \"连板数\": 0,\n540\t                    \"首次封板时间\": \"99:99:99\",\n541\t                    \"首次涨停日期\": d,\n542\t                }\n543\t            lb = row.get(\"连板数\", 0)\n544\t            if pd.isna(lb):\n545\t                lb = 0\n546\t            lb = int(lb)\n547\t            ft = str(row.get(\"首次封板时间\", \"99:99:99\"))\n548\t            if lb > stock_zt_detail[code][\"连板数\"] or (\n549\t                lb == stock_zt_detail[code][\"连板数\"] and ft < stock_zt_detail[code][\"首次封板时间\"]\n550\t            ):\n551\t                stock_zt_detail[code][\"连板数\"] = lb\n552\t                stock_zt_detail[code][\"首次封板时间\"] = ft\n553\t\n554\t    potential_leaders = []\n555\t    for code, count in stock_zt_count.items():\n556\t        if count >= 4:\n557\t            info = stock_zt_detail[code]\n558\t            info[\"涨停天数\"] = count\n559\t            potential_leaders.append(info)\n560\t\n561\t    if not potential_leaders:\n562\t        print(\"  ❌ 无潜在龙头（近5日涨停>=4天），识别结束\")\n563\t        return []\n564\t\n565\t    potential_leaders.sort(key=lambda x: (x[\"涨停天数\"], x[\"连板数\"]), reverse=True)\n566\t    leader_codes_set = {ldr[\"代码\"] for ldr in potential_leaders}\n567\t\n568\t    print(f\"  潜在龙头数量: {len(potential_leaders)}\")\n569\t    for ldr in potential_leaders[:10]:\n570\t        print(f\"    {ldr['名称']}({ldr['代码']}) 涨停{ldr['涨停天数']}天 连板{ldr['连板数']}\")\n571\t\n572\t    # ----------------------------------------------------------------\n573\t    # 第2步：检索龙头所属的全部概念板块（从缓存反向索引秒查）\n574\t    # ----------------------------------------------------------------\n575\t    print(\"\\n  [第2步] 检索龙头所属的全部概念板块...\")\n576\t\n577\t    stock_concept_index = build_stock_concept_index()\n578\t    if not stock_concept_index:\n579\t        print(\"  ❌ 概念索引为空\")\n580\t        return []\n581\t\n582\t    board_candidate_pool = {}\n583\t\n584\t    for ldr in potential_leaders:\n585\t        code = ldr[\"代码\"]\n586\t        concepts = stock_concept_index.get(code, [])\n587\t        if not concepts:\n588\t            print(f\"    ⚠ {ldr['名称']}({code}) 无概念板块数据\")\n589\t            continue\n590\t\n591\t        for c in concepts:\n592\t            board_name = c[\"概念名称\"]\n593\t            if board_name not in board_candidate_pool:\n594\t                board_candidate_pool[board_name] = {\n595\t                    \"板块名称\": board_name,\n596\t                    \"板块代码\": c[\"概念代码\"],\n597\t                    \"龙头列表\": [],\n598\t                    \"成分股代码集\": set(),\n599\t                }\n600\t            board_candidate_pool[board_name][\"龙头列表\"].append(ldr)\n601\t\n602\t    if not board_candidate_pool:\n603\t        print(\"  ❌ 无概念板块包含龙头\")\n604\t        return []\n605\t\n606\t    # 仅对候选板块（通常 10-30 个）拉取成分股\n607\t    for board_name, board_info in board_candidate_pool.items():\n608\t        constituents = fetch_board_constituents(board_info[\"板块代码\"], board_name)\n609\t        if not constituents.empty:\n610\t            board_info[\"成分股代码集\"] = set(constituents[\"代码\"].tolist())\n611\t\n612\t    print(f\"  有龙头的概念板块数量: {len(board_candidate_pool)}\")\n613\t\n614\t    # ----------------------------------------------------------------\n615\t    # 第3步：计算板块近3日涨幅和日均涨停家数\n616\t    # ----------------------------------------------------------------\n617\t    print(\"\\n  [第3步] 计算板块近3日涨幅和日均涨停家数...\")\n618\t\n619\t    start_d = (pd.to_datetime(eval_date) - pd.Timedelta(days=30)).strftime(\"%Y%m%d\")\n620\t\n621\t    for board_name, board_info in board_candidate_pool.items():\n622\t        # --- 板块近3日涨幅 ---\n623\t        board_idx = fetch_board_index(board_name, start_d, date_str)\n624\t        if board_idx.empty or len(board_idx) < 4:\n625\t            board_info[\"近3日涨幅\"] = -999.0\n626\t        else:\n627\t            close_col = \"收盘价\" if \"收盘价\" in board_idx.columns else \"收盘\"\n628\t            closes = board_idx[close_col].values\n629\t            board_info[\"近3日涨幅\"] = float((closes[-1] - closes[-4]) / closes[-4])\n630\t\n631\t        # --- 近3日每日涨停家数 ---\n632\t        daily_limit_count = []\n633\t        constituent_codes = board_info[\"成分股代码集\"]\n634\t        for d in recent_3_dates:\n635\t            lt_data = all_limit_up_data.get(d)\n636\t            if lt_data is not None and not lt_data.empty:\n637\t                lt_codes = set(lt_data[\"代码\"].tolist())\n638\t                daily_limit_count.append(len(constituent_codes & lt_codes))\n639\t            else:\n640\t                daily_limit_count.append(0)\n641\t\n642\t        board_info[\"涨停家数列表\"] = daily_limit_count\n643\t        board_info[\"日均涨停家数\"] = float(np.mean(daily_limit_count)) if daily_limit_count else 0.0\n644\t\n645\t        # --- 领涨龙头：连板数最高 ---\n646\t        sorted_leaders = sorted(\n647\t            board_info[\"龙头列表\"],\n648\t            key=lambda x: (x.get(\"连板数\", 0), x.get(\"涨停天数\", 0)),\n649\t            reverse=True,\n650\t        )\n651\t        board_info[\"领涨龙头\"] = sorted_leaders[0] if sorted_leaders else {}\n652\t\n653\t    # ----------------------------------------------------------------\n654\t    # 第4步：涨幅排名前5%\n655\t    # ----------------------------------------------------------------\n656\t    board_returns_list = sorted(\n657\t        [(n, i[\"近3日涨幅\"]) for n, i in board_candidate_pool.items() if i[\"近3日涨幅\"] > -999],\n658\t        key=lambda x: x[1], reverse=True,\n659\t    )\n660\t    if not board_returns_list:\n661\t        print(\"  ❌ 无板块有有效涨幅数据\")\n662\t        return []\n663\t\n664\t    top_n = max(1, int(len(board_returns_list) * CONFIG.board_return_top_pct))\n665\t    top_threshold = board_returns_list[min(top_n, len(board_returns_list)) - 1][1]\n666\t    print(f\"  前5%涨幅阈值: {top_threshold:.4f}（有效板块{len(board_returns_list)}个，前{top_n}个）\")\n667\t\n668\t    # ----------------------------------------------------------------\n669\t    # 第5步：筛选同时满足条件的板块\n670\t    # ----------------------------------------------------------------\n671\t    qualified = []\n672\t    for board_name, info in board_candidate_pool.items():\n673\t        return_3d = info.get(\"近3日涨幅\", -999)\n674\t        avg_limit = info.get(\"日均涨停家数\", 0)\n675\t        leader = info.get(\"领涨龙头\", {})\n676\t\n677\t        if return_3d >= top_threshold and avg_limit >= CONFIG.board_daily_limit_up_min:\n678\t            qualified.append({\n679\t                \"板块代码\": info[\"板块代码\"],\n680\t                \"板块名称\": board_name,\n681\t                \"近3日涨幅\": return_3d,\n682\t                \"日均涨停家数\": avg_limit,\n683\t                \"领涨龙头\": leader,\n684\t                \"成分股代码集\": info[\"成分股代码集\"],\n685\t                \"排序分\": avg_limit * 10 + leader.get(\"连板数\", 0),\n686\t            })\n687\t\n688\t    qualified.sort(key=lambda x: x[\"排序分\"], reverse=True)\n689\t    main_sectors = qualified[: CONFIG.top_sectors_count]\n690\t\n691\t    print(f\"\\n  主线板块筛选结果 ({len(main_sectors)}个):\")\n692\t    for s in main_sectors:\n693\t        ldr = s[\"领涨龙头\"]\n694\t        print(f\"    {s['板块名称']} | 涨幅:{s['近3日涨幅']:.2%} | \"\n695\t              f\"日均涨停:{s['日均涨停家数']:.1f} | \"\n696\t              f\"龙头:{ldr.get('名称','?')}({ldr.get('代码','?')}) \"\n697\t              f\"涨停{ldr.get('涨停天数',0)}天 连板{ldr.get('连板数',0)}\")\n698\t\n699\t    return main_sectors\n700\t\n701\t\n702\t# ============================================================\n703\t# 第二步：圈定候选跟风股\n704\t# ============================================================\n705\tdef screen_followers(main_sectors: List[Dict], eval_date: str) -> List[Dict]:\n706\t    \"\"\"\n707\t    圈定候选跟风股：\n708\t    1.txt. 与龙头近60日收益率相关系数 >= 0.7\n709\t    2. 龙头首个涨停日，个股涨幅 >= 5% 或 量比 >= 1.txt.5\n710\t    3. 当前价距近3个月最高价 < 15%\n711\t    4. 流通市值 <= 300亿\n712\t    \"\"\"\n713\t    print(\"\\n===== 第二步：圈定候选跟风股 =====\")\n714\t\n715\t    date_str = to_date_str(eval_date)\n716\t    start_date = (pd.to_datetime(eval_date) - pd.Timedelta(days=CONFIG.data_lookback_days)).strftime(\"%Y%m%d\")\n717\t\n718\t    candidates = []\n719\t\n720\t    for sector in main_sectors:\n721\t        leader = sector[\"领涨龙头\"]\n722\t        leader_code = leader[\"代码\"]\n723\t        leader_name = leader[\"名称\"]\n724\t        board_name = sector[\"板块名称\"]\n725\t        constituent_codes = sector.get(\"成分股代码集\", set())\n726\t\n727\t        print(f\"\\n  板块: {board_name}, 龙头: {leader_name}({leader_code})\")\n728\t        print(f\"  成分股数量: {len(constituent_codes)}\")\n729\t\n730\t        leader_df = fetch_stock_daily(leader_code, start_date, date_str)\n731\t        if leader_df.empty or len(leader_df) < 60:\n732\t            print(f\"    ⚠ 龙头数据不足，跳过该板块\")\n733\t            continue\n734\t\n735\t        leader_df = leader_df.set_index(\"日期\")\n736\t        leader_returns = leader_df[\"收盘\"].pct_change().dropna()\n737\t\n738\t        leader_first_zt_date = leader[\"首次涨停日期\"]\n739\t        leader_lb = leader[\"连板数\"]\n740\t        if leader_lb > 1:\n741\t            trade_dates_all = get_trade_dates(eval_date, 20)\n742\t            try:\n743\t                idx = trade_dates_all.index(leader_first_zt_date)\n744\t                first_idx = max(0, idx - leader_lb + 1)\n745\t                leader_first_zt_date = trade_dates_all[first_idx]\n746\t            except (ValueError, IndexError):\n747\t                pass\n748\t\n749\t        leader_first_zt_dt = pd.to_datetime(leader_first_zt_date)\n750\t\n751\t        stock_count = 0\n752\t        matched_count = 0\n753\t        for code in constituent_codes:\n754\t            if code == leader_code:\n755\t                continue\n756\t            stock_count += 1\n757\t\n758\t            stock_df = fetch_stock_daily(code, start_date, date_str)\n759\t            if stock_df.empty or len(stock_df) < 60:\n760\t                continue\n761\t\n762\t            stock_df = stock_df.set_index(\"日期\")\n763\t            stock_returns = stock_df[\"收盘\"].pct_change().dropna()\n764\t\n765\t            common_idx = leader_returns.index.intersection(stock_returns.index)\n766\t            if len(common_idx) < 30:\n767\t                continue\n768\t\n769\t            corr = leader_returns.loc[common_idx].corr(stock_returns.loc[common_idx])\n770\t            if pd.isna(corr) or corr < CONFIG.corr_threshold:\n771\t                continue\n772\t\n773\t            if leader_first_zt_dt not in stock_df.index:\n774\t                continue\n775\t\n776\t            zt_day_data = stock_df.loc[leader_first_zt_dt]\n777\t            if isinstance(zt_day_data, pd.DataFrame):\n778\t                zt_day_data = zt_day_data.iloc[0]\n779\t\n780\t            zt_day_change = zt_day_data.get(\"涨跌幅\", 0)\n781\t            if pd.isna(zt_day_change):\n782\t                zt_day_change = 0\n783\t            zt_day_change = zt_day_change / 100 if abs(zt_day_change) > 1 else zt_day_change\n784\t\n785\t            zt_day_volume = zt_day_data.get(\"成交量\", 0)\n786\t            avg_vol_20 = stock_df[\"成交量\"].rolling(20).mean()\n787\t            if leader_first_zt_dt in avg_vol_20.index:\n788\t                vol_20 = avg_vol_20.loc[leader_first_zt_dt]\n789\t            else:\n790\t                vol_20 = stock_df[\"成交量\"].tail(20).mean()\n791\t            vol_ratio = zt_day_volume / vol_20 if vol_20 > 0 else 0\n792\t\n793\t            if not (zt_day_change >= CONFIG.follower_change_threshold or vol_ratio >= CONFIG.follower_volume_ratio):\n794\t                continue\n795\t\n796\t            recent_high = stock_df[\"最高\"].tail(CONFIG.high_price_lookback).max()\n797\t            current_close = stock_df[\"收盘\"].iloc[-1]\n798\t            high_distance = (recent_high - current_close) / recent_high\n799\t            if high_distance >= CONFIG.high_price_distance:\n800\t                continue\n801\t\n802\t            market_cap = 0\n803\t            try:\n804\t                if \"流通市值\" in stock_df.columns:\n805\t                    market_cap = stock_df[\"流通市值\"].iloc[-1]\n806\t            except Exception:\n807\t                pass\n808\t\n809\t            if market_cap > 0 and market_cap / 1e8 > CONFIG.market_cap_limit:\n810\t                continue\n811\t\n812\t            matched_count += 1\n813\t            stock_name = \"\"\n814\t            try:\n815\t                stock_name = zt_day_data.get(\"名称\", code) if isinstance(zt_day_data, pd.Series) else code\n816\t            except Exception:\n817\t                stock_name = code\n818\t\n819\t            candidates.append({\n820\t                \"代码\": code,\n821\t                \"名称\": stock_name,\n822\t                \"板块\": board_name,\n823\t                \"对应龙头\": leader_name,\n824\t                \"龙头代码\": leader_code,\n825\t                \"相关系数\": round(corr, 4),\n826\t                \"龙头涨停日涨幅\": round(zt_day_change, 4),\n827\t                \"龙头涨停日量比\": round(vol_ratio, 2),\n828\t                \"近高点距离\": round(high_distance, 4),\n829\t                \"当前价格\": current_close,\n830\t                \"日线数据\": stock_df,\n831\t            })\n832\t\n833\t        print(f\"    遍历成分股: {stock_count}, 匹配: {matched_count}\")\n834\t\n835\t    print(f\"\\n  候选跟风股总数: {len(candidates)}\")\n836\t    return candidates\n837\t\n838\t\n839\t# ============================================================\n840\t# 第三步：技术信号共振确认\n841\t# ============================================================\n842\tdef check_macd_golden_cross(df: pd.DataFrame) -> bool:\n843\t    \"\"\"检查MACD金叉\"\"\"\n844\t    close = df[\"收盘\"]\n845\t    volume = df[\"成交量\"]\n846\t\n847\t    diff, dea, macd_hist = calc_macd(close)\n848\t\n849\t    if len(diff) < 2 or pd.isna(diff.iloc[-1]) or pd.isna(dea.iloc[-1]):\n850\t        return False\n851\t\n852\t    today_diff = diff.iloc[-1]\n853\t    today_dea = dea.iloc[-1]\n854\t    yesterday_diff = diff.iloc[-2]\n855\t    yesterday_dea = dea.iloc[-2]\n856\t\n857\t    avg_vol_20 = volume.rolling(20).mean().iloc[-1]\n858\t    today_vol = volume.iloc[-1]\n859\t    vol_ratio = today_vol / avg_vol_20 if avg_vol_20 > 0 else 0\n860\t\n861\t    golden_cross = (today_diff > today_dea) and (yesterday_diff <= yesterday_dea)\n862\t    diff_ok = today_diff >= CONFIG.macd_diff_threshold\n863\t    vol_ok = vol_ratio > 1.0\n864\t\n865\t    return golden_cross and diff_ok and vol_ok\n866\t\n867\t\n868\tdef check_bollinger_buy(df: pd.DataFrame) -> bool:\n869\t    \"\"\"检查布林通道买点（站上中轨）\"\"\"\n870\t    close = df[\"收盘\"]\n871\t    volume = df[\"成交量\"]\n872\t\n873\t    upper, mid, lower = calc_bbands(close)\n874\t\n875\t    if len(mid) < 2 or pd.isna(mid.iloc[-1]):\n876\t        return False\n877\t\n878\t    today_close = close.iloc[-1]\n879\t    yesterday_close = close.iloc[-2]\n880\t    today_mid = mid.iloc[-1]\n881\t    yesterday_mid = mid.iloc[-2]\n882\t\n883\t    mid_slope = today_mid - yesterday_mid\n884\t    avg_vol_20 = volume.rolling(20).mean().iloc[-1]\n885\t    today_vol = volume.iloc[-1]\n886\t    vol_ratio = today_vol / avg_